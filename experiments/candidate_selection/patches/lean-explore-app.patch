+"""Regression tests for search depth at the HTTP execution boundary."""
+
+import asyncio
+
+import pytest
+from flask import Flask
+from lean_explore.models import SearchResult
+
+from app.backend.api.search import _execute_search_async
+from app.backend.app import _perform_public_search_async
+from app.backend.core import extensions
+from app.backend.core.search_selection import configure_search_depth
+
+
+class RecordingEngine:
+    """Return up to the requested limit while recording the reranking budget."""
+
+    def __init__(self):
+        """Start without a recorded request."""
+        self.options = {}
+
+    async def search(self, **options):
+        """Record the request and return synthetic declaration results."""
+        self.options = options
+        return [
+            SearchResult(
+                id=index,
+                name=f"Test.lemma{index}",
+                module="Mathlib.Test",
+                source_text="",
+                source_link="",
+                dependencies=None,
+                docstring=None,
+                informalization=None,
+            )
+            for index in range(options["limit"])
+        ]
+
+
+@pytest.mark.parametrize("limit", [5, 10, 50, 100, 200])
+@pytest.mark.parametrize("configured_depth", [None, 50, 100])
+@pytest.mark.parametrize("public", [False, True])
+def test_reranking_budget_is_independent_of_short_response(
+    app, monkeypatch, limit, configured_depth, public
+):
+    """Both paths honor the configured pool and preserve an unset baseline."""
+    engine = RecordingEngine()
+    monkeypatch.setattr(extensions, "search_engine", engine)
+    monkeypatch.setitem(app.config, "SEARCH_RERANK_DEPTH", configured_depth)
+    with app.app_context():
+        if public:
+            result = asyncio.run(
+                _perform_public_search_async("test", ["Mathlib"], limit, "127.0.0.1")
+            )
+        else:
+            result = asyncio.run(_execute_search_async("test", ["Mathlib"], limit))
+    results, count = result
+    assert len(results) == count == limit
+    assert engine.options["rerank_top"] == max(limit, configured_depth or limit)
+    assert engine.options["packages"] == ["Mathlib"]
+
+
+@pytest.mark.parametrize("value", ["0", "-1", "201", "invalid"])
+def test_invalid_depth_rejected_at_startup(monkeypatch, value):
+    """Invalid experimental budgets fail before serving requests."""
+    monkeypatch.setenv("LEAN_EXPLORE_SEARCH_RERANK_DEPTH", value)
+    with pytest.raises(ValueError, match="1-200"):
+        configure_search_depth(Flask(__name__))
+
+
+def test_depth_loaded_from_environment(monkeypatch):
+    """The explicit deployment setting supplies the experimental pool size."""
+    monkeypatch.setenv("LEAN_EXPLORE_SEARCH_RERANK_DEPTH", "100")
+    application = Flask(__name__)
+    configure_search_depth(application)
+    assert application.config["SEARCH_RERANK_DEPTH"] == 100
