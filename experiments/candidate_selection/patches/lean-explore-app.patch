+"""Server-side reranking depth for controlled candidate selection experiments."""
+
+import os
+
+from flask import Flask, current_app
+
+
+def configure_search_depth(app: Flask) -> None:
+    """Read an optional reranking budget; leave legacy behavior as the default."""
+    raw = os.getenv("LEAN_EXPLORE_SEARCH_RERANK_DEPTH")
+    if not raw:
+        return
+    try:
+        depth = int(raw)
+    except ValueError:
+        raise ValueError("LEAN_EXPLORE_SEARCH_RERANK_DEPTH must be 1-200.") from None
+    if not 1 <= depth <= 200:
+        raise ValueError("LEAN_EXPLORE_SEARCH_RERANK_DEPTH must be 1-200.")
+    app.config["SEARCH_RERANK_DEPTH"] = depth
+
+
+def search_rerank_depth(limit: int) -> int:
+    """Return the configured budget, large enough to satisfy the result limit."""
+    configured = current_app.config.get("SEARCH_RERANK_DEPTH")
+    return max(limit, configured) if configured is not None else limit
