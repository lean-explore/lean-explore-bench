diff --git a/src/lean_explore/search/trace.py b/src/lean_explore/search/trace.py
new file mode 100644
--- /dev/null
+++ b/src/lean_explore/search/trace.py
@@ -0,0 +1,38 @@
+"""Opt-in, in-memory traces for candidate selection experiments."""
+
+from collections.abc import Iterable
+from dataclasses import dataclass, field
+from time import perf_counter
+
+
+@dataclass
+class SearchTrace:
+    """Candidate IDs in rank order and cumulative time at each search stage.
+
+    A search resets the trace before use. Nothing is logged or persisted.
+    Timings include loading unless the caller warms the engine first.
+    Use one instance per search.
+    """
+
+    stages: dict[str, list[int]] = field(default_factory=dict)
+    elapsed_ms: dict[str, float] = field(default_factory=dict)
+    _started: float = field(default_factory=perf_counter, repr=False)
+
+    def reset(self) -> None:
+        """Clear a previous search and restart the clock."""
+        self.stages.clear()
+        self.elapsed_ms.clear()
+        self._started = perf_counter()
+
+    def record(self, stage: str, identifiers: Iterable[int]) -> None:
+        """Store ordered IDs and cumulative elapsed milliseconds."""
+        self.stages[stage] = list(identifiers)
+        self.elapsed_ms[stage] = (perf_counter() - self._started) * 1000
+
+
+def record_stage(
+    trace: SearchTrace | None, stage: str, identifiers: Iterable[int]
+) -> None:
+    """Record a stage only when the caller requests a trace."""
+    if trace is not None:
+        trace.record(stage, identifiers)
